  "description": "美妆护肤品类数据库，按决策难度与价格区间从高端(T1)到低端(T5)分级。用于礼物推荐时的品类优先级、降级路径与预算兜底。",

  "tier_definition": {
    "T1": {
      "name": "重决策高单价品类",
      "price_range_cny": "800-5000+",
      "decision_difficulty": 5,
      "description": "高单价、肤质敏感、对方偏好难判断，送礼门槛最高"
    },
    "T2": {
      "name": "中高决策品类",
      "price_range_cny": "400-2000",
      "decision_difficulty": 4,
      "description": "对方常用品牌敏感，需识别色号/肤质"
    },
    "T3": {
      "name": "中等决策品类",
      "price_range_cny": "200-800",
      "decision_difficulty": 3,
      "description": "决策门槛中等，可作 T1/T2 预算不足时的降级目标"
    },
    "T4": {
      "name": "轻决策日常品类",
      "price_range_cny": "100-400",
      "decision_difficulty": 2,
      "description": "日常消耗品，品牌敏感度低，送礼安全度高"
    },
    "T5": {
      "name": "通用辅助品类",
      "price_range_cny": "50-300",
      "decision_difficulty": 1,
      "description": "辅助或补品类，常作搭配赠品"
    }
  },

